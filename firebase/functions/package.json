    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "googleapis": "^171.4.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0"
  }
}
