rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidOwnUserSettingsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data;
      return changed.hasOnly([
          "notificationsEnabled",
          "nightQuietEnabled",
          "uiLanguage",
          "lastSeenAt",
          "updatedAt"
        ])
        && (!changed.hasAny(["notificationsEnabled"])
          || next.notificationsEnabled is bool)
        && (!changed.hasAny(["nightQuietEnabled"])
          || next.nightQuietEnabled is bool)
        && (!changed.hasAny(["uiLanguage"])
          || !next.keys().hasAny(["uiLanguage"])
          || next.uiLanguage in ["ko", "ja"])
        && (!changed.hasAny(["lastSeenAt"])
          || next.lastSeenAt is timestamp)
        && (!changed.hasAny(["updatedAt"])
          || next.updatedAt is timestamp);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ===== users/{uid} =====
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // User profile creation is server-owned through completeOnboarding so
      // initial points, moderation state, and safety counters cannot be forged.
      allow create: if false;

      // Profile and identity fields are server-owned through updateMyProfile.
      // Direct writes remain limited to low-risk settings and presence state.
      allow update: if request.auth != null && request.auth.uid == uid
        && (!resource.data.keys().hasAny(["isBanned"])
          || resource.data.isBanned != true)
        && (!resource.data.keys().hasAny(["status"])
          || (resource.data.status != "banned"
            && resource.data.status != "deleted"
            && resource.data.status != "deactivated"))
        && (!resource.data.keys().hasAny(["deletionRequested"])
          || resource.data.deletionRequested != true)
        && (!resource.data.keys().hasAny(["accountStatus"])
          || (resource.data.accountStatus != "deleting"
            && resource.data.accountStatus != "deleted"
            && resource.data.accountStatus != "deactivated"
            && resource.data.accountStatus != "banned"))
        && isValidOwnUserSettingsUpdate();

      match /seen/{otherUid} {
        allow read, write: if false;
      }

      match /blocks/{otherUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["read"]);
        allow create, delete: if false;
      }
    }

    // ===== likes/{fromUid_toUid} =====
    // Discovery likes are server-owned so block/report checks cannot be bypassed.
    match /likes/{likeId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
      allow create, update, delete: if false;
    }

    // ===== matches/{matchId} =====
    match /matches/{matchId} {
      function isExactDirectRoom() {
        return resource.data.userIds is list
          && resource.data.userIds.size() == 2
          && resource.data.userIds[0] is string
          && resource.data.userIds[1] is string
          && resource.data.userIds[0] != resource.data.userIds[1];
      }

      allow get: if request.auth != null
        && isExactDirectRoom()
        && request.auth.uid in resource.data.userIds
        && resource.data.isActive == true
        && !(request.auth.uid in resource.data.hiddenFor);

      allow list: if request.auth != null
        && request.auth.uid in resource.data.userIds
        && resource.data.isActive == true
        && resource.data.directRoomVersion == 1;

      // Chat-room creation, point deduction, leaving, favorites, unread updates,
      // and summary updates are server-owned Cloud Function operations.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/matches/$(matchId)).data.userIds is list
          && get(/databases/$(database)/documents/matches/$(matchId)).data.userIds.size() == 2
          && get(/databases/$(database)/documents/matches/$(matchId)).data.userIds[0] != get(/databases/$(database)/documents/matches/$(matchId)).data.userIds[1]
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds
          && get(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true
          && !(request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.hiddenFor);

        // Message writes go through the sendMessage callable so the server can
        // enforce active-room, block, ban, and immutable originalText checks.
        allow create, update, delete: if false;
      }
    }

    // ===== chatPairs/{pairKey} =====
    // Pair pointers are server-owned implementation details for startChat.
    match /chatPairs/{pairKey} {
      allow read, write: if false;
    }

    // ===== calls/{callId} =====
    // Call creation, point charging, accepting, ending, and extension are
    // server-owned. Participants can only read their own call state.
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerUid
            || request.auth.uid == resource.data.calleeUid);
      allow create, update, delete: if false;
    }

    // Active call pointers are server-owned implementation details.
    match /activeCalls/{matchId} {
      allow read, write: if false;
    }

    // Daily free voice-call quotas are server-owned.
    match /callDailyQuotas/{quotaId} {
      allow read, write: if false;
    }

    // ===== posts/{postId} =====
    match /posts/{postId} {
      // Lounge reads go through Cloud Functions so block/report visibility can
      // include users who blocked the caller.
      allow read: if false;
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if false;
        allow create, update, delete: if false;

        match /replies/{replyId} {
          allow read: if false;
          allow create, update, delete: if false;
        }
      }
    }

    // ===== post_likes/{postId}/likes/{uid} =====
    match /post_likes/{postId}/likes/{uid} {
      allow read, write: if false;
    }

    // ===== ratings/{ratingId} =====
    match /ratings/{ratingId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.raterUid
            || request.auth.uid == resource.data.ratedUid);
      allow create, update, delete: if false;
    }

    // ===== reports/{reportId} =====
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // ===== reportCounters/{targetUid}/reporters/{reporterUid} =====
    match /reportCounters/{targetUid}/{document=**} {
      allow read, write: if false;
    }

    // ===== pointEvents/{eventId} =====
    // Point grants, purchases, consumes, refunds, and future payment ledgers are
    // server-owned audit records.
    match /pointEvents/{eventId} {
      allow read, write: if false;
    }

    // ===== playPurchases/{purchaseTokenHash} =====
    // Verified Play purchase tokens and grant state are server-owned.
    match /playPurchases/{purchaseTokenHash} {
      allow read, write: if false;
    }

    // ===== storeVerificationQuotas/{uid} =====
    // Per-account verification budgets are server-owned abuse controls.
    match /storeVerificationQuotas/{uid} {
      allow read, write: if false;
    }

    // ===== storeTransactions/{platformTransactionId} =====
    // Globally unique verified store transactions and their grant state are
    // server-owned. Clients receive only the callable result and public point
    // balance, never ledger or receipt metadata.
    match /storeTransactions/{platformTransactionId} {
      allow read, write: if false;
    }

    // ===== pendingStorePurchases/{pendingId} =====
    // Retry leases, purchase tokens, attempt counts, and terminal state are
    // server-owned and must not be disclosed or reset by clients.
    match /pendingStorePurchases/{pendingId} {
      allow read, write: if false;
    }

    // ===== fcmTokenOwners/{tokenHash} =====
    // A token can belong to only one current Firebase account. Raw tokens and
    // ownership transfers are server-owned.
    match /fcmTokenOwners/{tokenHash} {
      allow read, write: if false;
    }

    // ===== accountDeletionJobs/{uid} =====
    // Cleanup stage/error state is operational server data. The callable
    // exposes only its final result so clients cannot forge completion.
    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    // Media upload reservations and daily counters are server-owned abuse and
    // billing controls. Storage Rules may read them internally; clients may not.
    match /mediaUploadAuthorizations/{authorizationId} {
      allow read, write: if false;
    }

    match /mediaUploadQuotas/{quotaId} {
      allow read, write: if false;
    }

    match /privateMediaReadQuotas/{quotaId} {
      allow read, write: if false;
    }

    match /mediaUploadRequestQuotas/{quotaId} {
      allow read, write: if false;
    }

    match /mediaUploadGenerationCleanups/{cleanupId} {
      allow read, write: if false;
    }

    match /mediaUploadCleanupWorkerState/{workerId} {
      allow read, write: if false;
    }

    match /privateMediaRolloutControls/{controlId} {
      allow read, write: if false;
    }
  }
}
